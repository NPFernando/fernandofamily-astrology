[Unit]
Description=Fernando Family Astrology encrypted off-site PostgreSQL backup
Wants=network-online.target
After=network-online.target fernandofamily-db-backup.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/workspace/projects/fernandofamily-astrology
EnvironmentFile=/etc/fernandofamily-astrology/database-backup.env
Environment=ASTROLOGY_BACKUP_DIR=/var/backups/fernandofamily-astrology/postgres
Environment=RESTIC_CACHE_DIR=/var/cache/fernandofamily-astrology/restic
ExecStart=/usr/bin/env bash infra/deploy/database-offsite-backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/backups/fernandofamily-astrology/postgres /var/cache/fernandofamily-astrology/restic
