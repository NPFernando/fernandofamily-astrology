[Unit]
Description=Fernando Family Astrology PostgreSQL restore drill
Wants=network-online.target
After=network-online.target fernandofamily-db-backup.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/workspace/projects/fernandofamily-astrology
EnvironmentFile=/etc/fernandofamily-astrology/database-backup.env
Environment=ASTROLOGY_BACKUP_DIR=/var/backups/fernandofamily-astrology/postgres
ExecStart=/usr/bin/env bash infra/deploy/database-restore-drill.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/backups/fernandofamily-astrology/postgres
